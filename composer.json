{
    "name": "nowo-tech/code-review-guardian",
    "description": "Provider-agnostic code review guardian for PHP projects. Works with any PHP project (Symfony, Laravel, Yii, CodeIgniter, etc.) and any Git provider (GitHub, GitLab, Bitbucket, etc.)",
    "type": "composer-plugin",
    "license": "MIT",
    "abandoned": true,
    "keywords": [
        "code-review",
        "code-quality",
        "guardian",
        "php",
        "symfony",
        "laravel",
        "github",
        "gitlab",
        "bitbucket",
        "ci",
        "quality-assurance"
    ],
    "homepage": "https://github.com/nowo-tech/CodeReviewGuardian",
    "support": {
        "issues": "https://github.com/nowo-tech/CodeReviewGuardian/issues",
        "source": "https://github.com/nowo-tech/CodeReviewGuardian"
    },
    "authors": [
        {
            "name": "Héctor Franco Aceituno",
            "email": "hectorfranco@nowo.tech",
            "homepage": "https://github.com/HecFranco",
            "role": "Developer"
        },
        {
            "name": "Nowo.tech",
            "homepage": "https://nowo.tech"
        }
    ],
    "require": {
        "php": ">=8.1 <8.6",
        "composer-plugin-api": "^2.0"
    },
    "require-dev": {
        "composer/composer": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "nowo-tech/phpstan-frankenphp": "^1.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^9.6 || ^10.0 || ^11.0",
        "rector/rector": "^2.0",
        "symfony/framework-bundle": "^6.0 || ^7.0 || ^8.0"
    },
    "suggest": {
        "nowo-tech/composer-update-helper": "Keep your dependencies up to date. Works perfectly with Code Review Guardian to ensure both code quality and dependency management."
    },
    "autoload": {
        "psr-4": {
            "NowoTech\\CodeReviewGuardian\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NowoTech\\CodeReviewGuardian\\Tests\\": "tests/"
        }
    },
    "extra": {
        "class": "NowoTech\\CodeReviewGuardian\\Plugin",
        "branch-alias": {
            "dev-main": "1.1.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always --no-coverage",
        "test-coverage": "phpunit --colors=always --coverage-html coverage --coverage-clover coverage.xml --coverage-text",
        "cs-check": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.dist.php",
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "rector": "rector process",
        "rector-dry": "rector process --dry-run --no-progress-bar",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "qa": [
            "@cs-check",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run PHPUnit tests",
        "test-coverage": "Run PHPUnit tests with code coverage",
        "cs-check": "Check code style with PHP-CS-Fixer",
        "cs-fix": "Fix code style with PHP-CS-Fixer",
        "rector": "Apply Rector refactors",
        "rector-dry": "Run Rector in dry-run mode",
        "phpstan": "Run PHPStan static analysis",
        "qa": "Run all quality assurance checks"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        },
        "platform": {
            "php": "8.1.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/demo",
            "/.cursor"
        ]
    }
}
